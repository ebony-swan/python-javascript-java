{
  "project": "multi-language-owasp-lab",
  "description": "Ground-truth answer key for the multi-language OWASP lab. Each 'expected' entry is one deliberately-planted, exploitable vulnerability (one permutation). The engine (compare.py) scores any SAST report against this.",
  "note_vendor_neutral": "This file names no scanner. Severities are representative CVSS v3.1 bands, not any vendor's rating.",
  "cvss_bands": {"Critical": "9.0-10.0", "High": "7.0-8.9", "Medium": "4.0-6.9", "Low": "0.1-3.9"},

  "source_layout": {
    "_comment": "Where the project's source lives, so the engine can auto-locate the SAFE control handlers for precision scoring. 'root' is relative to this file; override at runtime with --source-root. If the source is absent (engine copied out on its own), coverage/recall still work and precision reports n/a.",
    "root": "..",
    "safe_marker": "safe",
    "modules": {
      "python": "python/app/vulns",
      "javascript": "javascript/routes",
      "java": "java/src/main/java/com/example/vulnapp/vulns",
      "go": "go",
      "csharp": "csharp/Controllers"
    }
  },

  "deferred_languages": {
    "php": "The PHP app is a work-in-progress (SQL injection and command injection implemented; the other categories are slated for a later build), so it is intentionally omitted from 'expected' until complete. Re-add a php block to 'expected' and a php entry to source_layout.modules to bring it into scoring."
  },

  "categories": {
    "sqli":    {"name": "SQL Injection",              "owasp_2021": "A03", "owasp_2025": "A05", "cwes": [89, 564]},
    "command": {"name": "Command Injection",          "owasp_2021": "A03", "owasp_2025": "A05", "cwes": [78, 88]},
    "xss":     {"name": "Cross-Site Scripting",       "owasp_2021": "A03", "owasp_2025": "A05", "cwes": [79, 80, 116, 1336]},
    "access":  {"name": "Broken Access Control",      "owasp_2021": "A01", "owasp_2025": "A01", "cwes": [639, 862, 863, 915, 285, 284, 602, 566]},
    "crypto":  {"name": "Cryptographic Failures",     "owasp_2021": "A02", "owasp_2025": "A04", "cwes": [327, 328, 326, 310, 916, 759, 760, 798, 321, 338, 330, 329, 261]},
    "deser":   {"name": "Software & Data Integrity",  "owasp_2021": "A08", "owasp_2025": "A08", "cwes": [502, 95, 94, 1321]},
    "ssrf":    {"name": "Server-Side Request Forgery","owasp_2021": "A10", "owasp_2025": "A01", "cwes": [918]},
    "path":    {"name": "Path Traversal",             "owasp_2021": "A01", "owasp_2025": "A01", "cwes": [22, 23, 36, 73]}
  },

  "module_patterns": [
    ["injection_sql", "sqli"], ["sqlinjection", "sqli"],
    ["injection_command", "command"], ["commandinjection", "command"],
    ["injection_xss", "xss"], ["xsscontroller", "xss"],
    ["access_control", "access"], ["accesscontrol", "access"],
    ["deserialization", "deser"],
    ["crypto", "crypto"],
    ["ssrf", "ssrf"],
    ["path_traversal", "path"], ["pathtraversal", "path"],
    ["db.", "__framework__"], ["__init__", "__framework__"],
    ["server.", "__framework__"], ["run.py", "__framework__"], ["schema", "__framework__"],
    ["main.go", "__framework__"], ["registry.go", "__framework__"], ["util.go", "__framework__"],
    ["program.cs", "__framework__"], ["index.php", "__framework__"], ["lib.php", "__framework__"]
  ],

